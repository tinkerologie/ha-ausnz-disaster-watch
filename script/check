#!/bin/bash

# script/check: Run linting and type checking tools together
#
# Runs type-check (Pyright), lint-check (Ruff), and spell-check (codespell) in sequence.
# Recommended before committing changes.
#
# Usage:
#   ./script/check
#
# Examples:
#   ./script/check

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

"$SCRIPT_DIR/type-check"
echo ""
"$SCRIPT_DIR/lint-check"
echo ""
"$SCRIPT_DIR/spell-check"

# Dashboard card design guard (#42): no deprecated patterns, and every HA token and
# element the cards use must exist in the installed Home Assistant frontend.
if command -v node >/dev/null 2>&1; then
    echo ""
    log_header "Checking dashboard cards (lint:modern, lint:drift)"
    node frontend/scripts/check-modern.mjs
    # An explicit HASS_FRONTEND wins; otherwise ask Python where hass_frontend lives.
    if [ -z "${HASS_FRONTEND:-}" ]; then
        HASS_FRONTEND="$(python3 -c 'import hass_frontend, pathlib; print(pathlib.Path(hass_frontend.__file__).parent / "frontend_latest")' 2>/dev/null || true)"
    fi
    # Required here: the drift check must not pass without a frontend to check against.
    HASS_FRONTEND="$HASS_FRONTEND" LINT_DRIFT_REQUIRED=1 node frontend/scripts/check-ha-drift.mjs
else
    log_warning "node not found; skipping dashboard card checks"
fi

# Run hassfest validation if it has been set up (only in local environment, not CI)
if [ -z "${CI:-}" ] && [ -z "${GITHUB_ACTIONS:-}" ] && [ -d "$SCRIPT_DIR/../.local/ha-core" ]; then
    echo ""
    "$SCRIPT_DIR/hassfest"
fi

log_success "All checks passed"
