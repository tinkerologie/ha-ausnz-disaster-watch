#!/bin/bash

# script/bootstrap: Install/update all dependencies required to run the project
#
# Bootstraps the development environment by installing system packages,
# setting up uv package manager, creating virtual environment, and installing
# Python dependencies including Home Assistant core and development tools.
#
# Usage:
#   ./script/setup/bootstrap
#
# Examples:
#   ./script/setup/bootstrap

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/../.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/../.lib/output.sh"

resolve_latest_homeassistant_version() {
    python3 - <<'PY'
import json
import re
import sys
from urllib.request import urlopen


def parse(version: str) -> tuple[int, int, int]:
    major, minor, patch = version.split(".")
    return int(major), int(minor), int(patch)


url = "https://pypi.org/pypi/homeassistant/json"
pattern = re.compile(r"^\d+\.\d+\.\d+$")

try:
    with urlopen(url, timeout=15) as response:
        payload = json.load(response)
except Exception:
    sys.exit(1)

releases = payload.get("releases", {})
stable_versions = [version for version in releases if pattern.match(version)]

if not stable_versions:
    sys.exit(1)

print(max(stable_versions, key=parse))
PY
}

validate_homeassistant_version() {
    local version="$1"
    # Accept a Core release or prerelease tag.
    local version_pattern='^[0-9]{4}\.[0-9]+\.[0-9]+((a|b|rc)[0-9]+)?$'

    if [[ ! "$version" =~ $version_pattern ]]; then
        return 1
    fi

    return 0
}

if [[ ${APT_UPDATE:-"0"} == "1" ]]; then
    log_header "Updating system packages"
    sudo apt-get update
    sudo apt-get upgrade -y
fi

log_header "Checking for uv"
if ! command -v uv >/dev/null 2>&1; then
    log_info "UV not found, installing..."
    pipx install uv
fi

log_header "Checking for Python virtual environment"

# Determine venv location based on environment
# In DevContainer: Use $HOME/.local/ha-venv (hardlinks work, avoids mount performance issues)
# Local development: Use .local/ha-venv in workspace (isolated per project)
# CI (GitHub Actions): Use $HOME/.local/ha-venv or workspace (both work)
if [[ -n "${REMOTE_CONTAINERS:-}" || -n "${CODESPACES:-}" ]]; then
    # Running in DevContainer or Codespaces
    VENV_PATH="$HOME/.local/ha-venv"
    VENV_IS_EXTERNAL=true
    log_info "DevContainer/Codespaces detected - using external venv"
elif [[ -n "${GITHUB_ACTIONS:-}" ]]; then
    # Running in GitHub Actions
    VENV_PATH="${GITHUB_WORKSPACE:-.}/.local/ha-venv"
    VENV_IS_EXTERNAL=false
    log_info "GitHub Actions detected - using workspace venv"
else
    # Local development (Mac, Linux, WSL)
    VENV_PATH=".local/ha-venv"
    VENV_IS_EXTERNAL=false
    log_info "Local development detected - using workspace venv"
fi

VENV_PYTHON=">=3.14.2,<3.15"
if [[ ! -e "$VENV_PATH" && ! -L "$VENV_PATH" ]]; then
    log_info "Creating virtual environment at $VENV_PATH"
    uv venv --python "$VENV_PYTHON" "$VENV_PATH"
elif [[ ! -f "$VENV_PATH/bin/activate" ]] ||
    ! "$VENV_PATH/bin/python3" -c 'import sys; sys.exit(sys.version_info < (3, 14, 2))' 2>/dev/null; then
    if [[ -L "$VENV_PATH" || ! -f "$VENV_PATH/pyvenv.cfg" ]]; then
        log_error "Cannot recreate $VENV_PATH. Move it aside, then run bootstrap again."
        exit 1
    fi
    log_info "Recreating the virtual environment at $VENV_PATH with Python 3.14.2 or later"
    uv venv --clear --python "$VENV_PYTHON" "$VENV_PATH"
fi

# Create symlinks for IDE compatibility and tool expectations
if [[ "$VENV_IS_EXTERNAL" == "true" ]]; then
    # DevContainer: Create symlink from workspace to external venv
    log_step "Creating workspace symlink for IDE type checking"
    mkdir -p .local
    # .local/ha-venv → /home/vscode/.local/ha-venv (absolute path - simpler and more reliable)
    if [[ -d .local/ha-venv && ! -L .local/ha-venv ]]; then
        log_warning "Skipping .local/ha-venv: directory already exists (not a symlink)"
    else
        ln -sf "$VENV_PATH" .local/ha-venv
    fi
fi

# Create compatibility symlinks for common venv locations (all environments)
log_step "Creating compatibility symlinks for tool expectations"
mkdir -p .local

# .venv → .local/ha-venv (Python/uv standard location)
if [[ -d .venv && ! -L .venv ]]; then
    log_warning "Skipping .venv: directory already exists (not a symlink)"
else
    ln -sf .local/ha-venv .venv
fi

# .local/venv → ha-venv (GitHub Copilot Agent expectation)
if [[ -d .local/venv && ! -L .local/venv ]]; then
    log_warning "Skipping .local/venv: directory already exists (not a symlink)"
else
    ln -sf ha-venv .local/venv
fi

# shellcheck source=/dev/null
source "$VENV_PATH/bin/activate"

# Auto-activate venv in shell RC files (only in DevContainer/Codespaces where venv is external)
if [[ "$VENV_IS_EXTERNAL" == "true" ]]; then
    set +e
    if [[ -f $HOME/.bashrc ]]; then
        if ! grep -q "source $VENV_PATH/bin/activate" "$HOME/.bashrc" 2>/dev/null; then
            log_step "Configuring Bash to auto-activate virtual environment"
            echo "source $VENV_PATH/bin/activate" >> "$HOME/.bashrc" || log_warning "Failed to update .bashrc"
        fi
    fi
    if [[ -f $HOME/.zshrc ]]; then
        if ! grep -q "source $VENV_PATH/bin/activate" "$HOME/.zshrc"; then
            log_step "Configuring ZSH to auto-activate virtual environment"
            echo "source $VENV_PATH/bin/activate" >> "$HOME/.zshrc" || log_warning "Failed to update .zshrc"
        fi
    fi
    set -e
fi

PLUGIN_REQUIREMENT="$(sed -En '/^pytest-homeassistant(==| @ )/p' requirements_test.txt)"
if [[ "$PLUGIN_REQUIREMENT" == pytest-homeassistant==* ]]; then
    PINNED_HA_VERSION="${PLUGIN_REQUIREMENT#*==}"
else
    PINNED_HA_VERSION="${PLUGIN_REQUIREMENT##*@}"
    PINNED_HA_VERSION="${PINNED_HA_VERSION%%#*}"
fi
if ! validate_homeassistant_version "$PINNED_HA_VERSION"; then
    log_error "requirements_test.txt must pin the official pytest-homeassistant plugin to a Core release"
    exit 1
fi
HA_VERSION_INPUT="${HA_VERSION:-$PINNED_HA_VERSION}"

if [[ "$HA_VERSION_INPUT" == "latest" || "$HA_VERSION_INPUT" == "stable" ]]; then
    log_header "Resolving latest stable Home Assistant version"
    if HA_VERSION="$(resolve_latest_homeassistant_version)"; then
        if ! validate_homeassistant_version "$HA_VERSION"; then
            log_error "Resolved Home Assistant version '$HA_VERSION' is invalid"
            exit 1
        fi
        log_info "Using latest stable Home Assistant version: ${BOLD}${HA_VERSION}${NC}"
    else
        log_error "Could not resolve the latest stable Home Assistant release"
        exit 1
    fi
else
    HA_VERSION="$HA_VERSION_INPUT"
    if ! validate_homeassistant_version "$HA_VERSION"; then
        log_error "Provided HA_VERSION '$HA_VERSION' is invalid"
        exit 1
    fi
fi

if [[ "$HA_VERSION" != "$PINNED_HA_VERSION" ]]; then
    # Resolve in a tool environment so a clean venv needs no extra install first.
    resolution="$(GITHUB_OUTPUT='' uv run --no-project --python "$VIRTUAL_ENV/bin/python" \
        --with packaging==26.0 --with certifi python "$SCRIPT_DIR/../ha_next_versions.py" --ha-version "$HA_VERSION")"
    PLUGIN_REQUIREMENT="$(sed -n 's/^plugin_requirement=//p' <<< "$resolution")"
fi
if [[ -z "$PLUGIN_REQUIREMENT" ]]; then
    log_error "No official pytest-homeassistant plugin supports Home Assistant $HA_VERSION and this Python."
    exit 1
fi

HA_CORE_BASE_URL="https://raw.githubusercontent.com/home-assistant/core/${HA_VERSION}"
if ! CORE_REQUIREMENTS_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ha-bootstrap.XXXXXX")"; then
    log_error "Could not create a temporary directory for Core requirements"
    exit 1
fi
cleanup_core_requirements() {
    if [[ -n "$CORE_REQUIREMENTS_DIR" && -d "$CORE_REQUIREMENTS_DIR" ]]; then
        rm -rf -- "$CORE_REQUIREMENTS_DIR" || log_warning "Could not remove the Core requirements directory"
    fi
}
trap cleanup_core_requirements EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir "$CORE_REQUIREMENTS_DIR/homeassistant"

log_header "Downloading requirements for Home Assistant $HA_VERSION"
# Core's requirements_all.txt includes requirements.txt. Its requirements_test.txt
# includes requirements_test_pre_commit.txt and constrains homeassistant/package_constraints.txt.
for file in homeassistant/package_constraints.txt requirements.txt requirements_all.txt requirements_test_pre_commit.txt requirements_test.txt; do
    curl -fsSL "$HA_CORE_BASE_URL/$file" -o "$CORE_REQUIREMENTS_DIR/$file"
done
# Core can refer to packages by checkout-relative paths. Bootstrap uses published
# dependencies or an explicit Core ref instead of a local Core source tree.
sed -E '/^[[:space:]]*(\.\/)?packages\//d' "$CORE_REQUIREMENTS_DIR/requirements_test.txt" \
    > "$CORE_REQUIREMENTS_DIR/requirements_test_filtered.txt"

log_header "Installing Home Assistant $HA_VERSION and its test environment"
uv pip install --upgrade --requirement requirements_dev.txt
if python -c 'import importlib.util, sys; sys.exit(importlib.util.find_spec("pytest_homeassistant_custom_component") is None)'; then
    uv pip uninstall pytest-homeassistant-custom-component
fi
uv pip install --upgrade --constraint "$CORE_REQUIREMENTS_DIR/homeassistant/package_constraints.txt" \
    --requirement requirements.txt \
    --requirement "$CORE_REQUIREMENTS_DIR/requirements_all.txt" \
    --requirement "$CORE_REQUIREMENTS_DIR/requirements_test_filtered.txt" \
    "homeassistant==$HA_VERSION" "$PLUGIN_REQUIREMENT"

python - "$HA_VERSION" "$PLUGIN_REQUIREMENT" <<'PYTHON'
from importlib.metadata import PackageNotFoundError, distribution, version
import json
import sys

expected, requirement = sys.argv[1:]
if version("homeassistant") != expected:
    sys.exit(f"Home Assistant did not install at {expected}")

plugin = distribution("pytest-homeassistant")
if requirement.startswith("pytest-homeassistant=="):
    if plugin.version != expected:
        sys.exit(f"The Home Assistant test plugin did not install at {expected}")
else:
    origin = json.loads(plugin.read_text("direct_url.json") or "{}")
    if origin.get("vcs_info", {}).get("requested_revision") != expected:
        sys.exit(f"The Home Assistant test plugin did not install from Core {expected}")

try:
    version("pytest-homeassistant-custom-component")
except PackageNotFoundError:
    pass
else:
    sys.exit("The retired Home Assistant test plugin is still installed")
print(f"Home Assistant {expected} and its matching test plugin are installed")
PYTHON

# Only install pre-commit hooks in local development, not in CI
# GITHUB_ACTIONS is always set to "true" in GitHub Actions environments
if [[ -d ".git" && -z "${GITHUB_ACTIONS:-}" ]]; then
    log_header "Installing pre-commit hooks"
    if [[ -e "$(git rev-parse --git-path hooks/pre-commit)" ]]; then
        log_info "Keeping the existing pre-commit hook"
    else
        prek install || log_warning "Failed to install pre-commit hooks"
    fi
else
    if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
        log_info "Skipping pre-commit hooks (running in GitHub Actions)"
    else
        log_info "Skipping pre-commit hooks (not a Git repository)"
    fi
fi

log_success "Bootstrap complete"
